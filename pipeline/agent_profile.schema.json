{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-profile.schema.json",
  "title": "Agent profile (one persona's behaviour distribution)",
  "description": "Everything the agent runner needs for one persona: house, simulation period, and behaviours. A behaviour is either a hidden pattern (kind 'pattern', the ground truth to be learned) or ordinary life (kind 'routine'). Both use the structured-pattern parts of pattern.schema.json (trigger, conditions, actions). Conventions inside actions: any args value may be {\"choice\": [..], \"weights\": [..]} (one option drawn each time, weights optional) and a number may be {\"min\": a, \"max\": b} (uniform). A time range whose 'to' is earlier than 'from' runs past midnight and belongs to the day it starts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "personaId",
    "houseType",
    "variant",
    "roomRoles",
    "simulation",
    "start",
    "behaviours"
  ],
  "properties": {
    "personaId": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "houseType": {
      "enum": [
        "2room",
        "3room",
        "4room"
      ]
    },
    "variant": {
      "type": "string",
      "description": "layout variant, e.g. 3room-A"
    },
    "roomRoles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startDate",
        "days",
        "seed"
      ],
      "properties": {
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "days": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "description": "random seed: the same profile and seed give the same year"
        }
      }
    },
    "start": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place"
      ],
      "description": "Where the person is at the first minute.",
      "properties": {
        "place": {
          "type": "string"
        },
        "room": {
          "type": "string"
        },
        "asleep": {
          "type": "boolean"
        },
        "battery": {
          "type": "number"
        }
      }
    },
    "behaviours": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description",
          "trigger",
          "conditions",
          "actions",
          "probability",
          "maxPerDay"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "pattern",
              "routine"
            ]
          },
          "description": {
            "type": "string"
          },
          "pattern": {
            "type": "object",
            "description": "kind 'pattern' only: the full structured pattern (pattern.schema.json) it comes from, kept for reference and ground truth"
          },
          "trigger": {
            "$ref": "pattern.schema.json#/$defs/trigger"
          },
          "conditions": {
            "type": "array",
            "items": {
              "$ref": "pattern.schema.json#/$defs/condition"
            }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "pattern.schema.json#/$defs/action"
            }
          },
          "probability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "chance the behaviour happens when the trigger fires and the conditions hold (a pattern's followProbability)"
          },
          "maxPerDay": {
            "type": "integer",
            "minimum": 1
          },
          "priority": {
            "type": "integer",
            "description": "when two behaviours want the person at the same minute, the higher one goes first (default 0)"
          },
          "shift": {
            "description": "preference_shift only (same as pattern.schema.json shift)"
          }
        }
      }
    },
    "phoneHabits": {
      "type": "object",
      "additionalProperties": false,
      "description": "How this person handles the phone screen. The engine turns the screen on when a phone use starts and off when it ends; these values decide how it goes off, and how often the person glances at the lock screen.",
      "properties": {
        "screenTimeoutSeconds": {
          "enum": [
            15,
            30,
            60,
            120,
            300,
            600
          ],
          "description": "The phone's screen time-out setting (Galaxy default 30)."
        },
        "manualScreenOff": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Chance the person turns the screen off by hand right after a use; otherwise it goes off after the time-out. Default 0.9. People differ a lot (Hintze et al. 2014)."
        },
        "glancesPerDay": {
          "type": "number",
          "minimum": 0,
          "description": "Looks at the lock screen without unlocking (time, notifications) per waking day. Default 22 (median in Hintze et al. 2014; mean 33)."
        },
        "dailySigma": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "Day-to-day variation of this person's phone use: each day the rate of the phone-use rules is multiplied by a lognormal factor with mean 1 and this sigma (Appiah et al. 2026: within-person CV of daily unlocks mostly above 25%). Written by pipeline/sample_phone_person.py."
        }
      }
    },
    "dryerLoad": {
      "type": "object",
      "additionalProperties": false,
      "description": "Only if the person has a dryer: shares of small / standard / large loads in the normal course (weights, any scale). The dryer then runs small 60-100 min (our choice), standard 100 min (Samsung 9 kg dryer, 4 kg load), large 100 + 16-50 min (triangular, mode 16; samsungsvc.co.kr/solution/1052607). A habit of the person, chosen from the persona (household size, how laundry is batched); no data. Absent: always standard.",
      "properties": {
        "small": {
          "type": "number",
          "minimum": 0
        },
        "standard": {
          "type": "number",
          "minimum": 0
        },
        "large": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "phoneUseLevel": {
      "enum": [
        "light",
        "medium",
        "heavy"
      ],
      "description": "How much the person uses the phone compared with other adults (lower, middle or upper third). Chosen by the LLM from the persona; pipeline/sample_phone_person.py draws the numbers from it."
    },
    "phonePerson": {
      "type": "object",
      "description": "Written by pipeline/sample_phone_person.py: the drawn values, the factors applied to the phone-use rules, the rules' original values (template) and the sources. Not read by the engine."
    },
    "cookingMinutes": {
      "$ref": "pattern.schema.json#/$defs/cookingMinutes",
      "description": "This person's usual cooking time: every time the stove is turned on, a time is drawn and the person turns it off then (a step may override it). Default lognormal, median 15, sigma 0.6."
    },
    "heatingRanges": {
      "type": "object",
      "additionalProperties": false,
      "description": "Heating habits of this person as ranges and weights chosen from the persona (no population data); pipeline/sample_heating_person.py draws heatingHabits from them. The engine keeps the room the person is in near comfortC in the heating season and applies the sleep / leaving / unused-room habits. Do not write heating routines.",
      "required": [
        "comfortC",
        "sleep",
        "leaving",
        "unusedRooms"
      ],
      "properties": {
        "comfortC": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "sleep": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keep": {
              "type": "number",
              "minimum": 0
            },
            "lower": {
              "type": "number",
              "minimum": 0
            },
            "off": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "sleepLowerC": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "leaving": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keep": {
              "type": "number",
              "minimum": 0
            },
            "lower": {
              "type": "number",
              "minimum": 0
            },
            "off": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "leavingLowerC": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "keepWhenOutdoorBelowC": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "min",
            "max"
          ]
        },
        "unusedRooms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "off": {
              "type": "number",
              "minimum": 0
            },
            "keep": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "heatingHabits": {
      "type": "object",
      "description": "Written by pipeline/sample_heating_person.py; read by the engine."
    },
    "heatingPerson": {
      "type": "object",
      "description": "Written by pipeline/sample_heating_person.py: seed and the ranges used. Not read by the engine."
    },
    "ventilationRanges": {
      "type": "object",
      "additionalProperties": false,
      "description": "Use of the flat's ventilation unit as weights chosen from the persona; pipeline/sample_ventilation_person.py draws ventilationHabits from them. The unit has no SmartThings capability: it writes no lines, only its effect on the rooms. Do not write ventilation routines.",
      "required": [
        "uses",
        "when",
        "winter"
      ],
      "properties": {
        "uses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "yes": {
              "type": "number",
              "minimum": 0
            },
            "no": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "always": {
              "type": "number",
              "minimum": 0
            },
            "home": {
              "type": "number",
              "minimum": 0
            },
            "awake": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "winter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "run": {
              "type": "number",
              "minimum": 0
            },
            "off": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "ventilationHabits": {
      "type": "object",
      "description": "Written by pipeline/sample_ventilation_person.py; read by the engine."
    },
    "ventilationPerson": {
      "type": "object",
      "description": "Written by pipeline/sample_ventilation_person.py: seed and the weights used. Not read by the engine."
    },
    "coolingRanges": {
      "type": "object",
      "additionalProperties": false,
      "description": "Use of the air conditioners as ranges and weights chosen from the persona; pipeline/sample_cooling_person.py draws coolingHabits. With coolingHabits the engine switches cooling on and off (logged) and the off rules for cooling units are not used.",
      "required": [
        "uses",
        "onAboveC",
        "setpointC",
        "sleep",
        "leaving",
        "unusedRooms"
      ],
      "properties": {
        "uses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "yes": {
              "type": "number",
              "minimum": 0
            },
            "no": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "onAboveC": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "setpointC": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "sleep": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keep": {
              "type": "number",
              "minimum": 0
            },
            "off": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "leaving": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "keep": {
              "type": "number",
              "minimum": 0
            },
            "off": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "unusedRooms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "off": {
              "type": "number",
              "minimum": 0
            },
            "keep": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "coolingHabits": {
      "type": "object",
      "description": "Written by pipeline/sample_cooling_person.py; read by the engine."
    },
    "coolingPerson": {
      "type": "object",
      "description": "Written by pipeline/sample_cooling_person.py: seed and the ranges used. Not read by the engine."
    },
    "windowRanges": {
      "type": "object",
      "additionalProperties": false,
      "description": "Window habits as ranges and weights chosen from the persona; pipeline/sample_window_person.py draws windowHabits. With windowHabits the engine opens and closes windows (logged where a window sensor exists) and the off rules for windows are not used.",
      "required": [
        "summerOpen",
        "openAboveC",
        "sleepOpen",
        "airingPerDay",
        "airingMinutes",
        "winterAiringMinutes"
      ],
      "properties": {
        "summerOpen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "yes": {
              "type": "number",
              "minimum": 0
            },
            "no": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "openAboveC": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "sleepOpen": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "yes": {
              "type": "number",
              "minimum": 0
            },
            "no": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "airingPerDay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "0": {
              "type": "number",
              "minimum": 0
            },
            "1": {
              "type": "number",
              "minimum": 0
            },
            "2": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "airingMinutes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        },
        "winterAiringMinutes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      }
    },
    "windowHabits": {
      "type": "object",
      "description": "Written by pipeline/sample_window_person.py; read by the engine."
    },
    "windowPerson": {
      "type": "object",
      "description": "Written by pipeline/sample_window_person.py: seed and the ranges used. Not read by the engine."
    },
    "hoodRanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "useShare"
      ],
      "description": "Share of cookings on which the person runs the kitchen range hood, as a range chosen from the persona; pipeline/sample_hood_person.py draws hoodHabits. The hood has no SmartThings capability: no lines, only its effect.",
      "properties": {
        "useShare": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "hoodHabits": {
      "type": "object",
      "description": "Written by pipeline/sample_hood_person.py; read by the engine."
    },
    "hoodPerson": {
      "type": "object",
      "description": "Written by pipeline/sample_hood_person.py: seed and the range used. Not read by the engine."
    },
    "showerRanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perDay",
        "when",
        "minutes"
      ],
      "description": "Shower habit as weights chosen from the persona; pipeline/sample_shower_person.py draws showerHabits, from which the engine makes routines (bathroom, light on, shower, light off). Do not write shower routines.",
      "properties": {
        "perDay": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "0": {
              "type": "number",
              "minimum": 0
            },
            "1": {
              "type": "number",
              "minimum": 0
            },
            "2": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "morning": {
              "type": "number",
              "minimum": 0
            },
            "evening": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "minutes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      }
    },
    "showerHabits": {
      "type": "object",
      "description": "Written by pipeline/sample_shower_person.py; read by the engine."
    },
    "showerPerson": {
      "type": "object",
      "description": "Written by pipeline/sample_shower_person.py: seed and the weights used. Not read by the engine."
    },
    "laundryRanges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "washesPerWeek",
        "weekendShare",
        "dryerShare"
      ],
      "description": "Laundry habit as ranges chosen from the persona: washes a week, the share on weekend mornings, the share put in the dryer (the rest dries on a rack indoors); pipeline/sample_laundry_person.py draws laundryHabits and the engine makes the washing routines. No dryer: dryerShare 0 to 0. Do not write washing or drying rules.",
      "properties": {
        "dryerShare": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "washesPerWeek": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "weekendShare": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "laundryHabits": {
      "type": "object",
      "description": "Written by pipeline/sample_laundry_person.py; read by the engine."
    },
    "laundryPerson": {
      "type": "object",
      "description": "Written by pipeline/sample_laundry_person.py: seed and the range used. Not read by the engine."
    }
  }
}
