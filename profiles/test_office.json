    {
      "id": "r_phone_use",
      "kind": "routine",
      "description": "Ordinary phone use while awake. About 39 uses a day from this rule (Winbush et al. 2025, 10,099 US adults: median 1.71 unlocks per hour, 41 a day) and about 5 hours of app time a day (data.ai Korea Q1 2022: 5.2 h). A university student: more video and social media than the Korean all-age per-app averages (WiseApp 2025).",
      "trigger": {
        "kind": "rate",
        "window": {
          "from": "07:30",
          "to": "23:50"
        },
        "perHour": 4.603
      },
      "conditions": [
        {
          "kind": "phone_state",
          "field": "asleep",
          "op": "==",
          "value": false
        }
      ],
      "actions": [
        {
          "do": "phone.useApps",
          "args": {
            "first": {
              "com.kakao.talk": 5,
              "com.instagram.android": 3,
              "com.google.android.youtube": 2,
              "com.android.chrome": 2,
              "com.google.android.apps.maps": 0.5
            },
            "next": {
              "com.kakao.talk": 4,
              "com.instagram.android": 2,
              "com.google.android.youtube": 1.5,
              "com.android.chrome": 1.5,
              "com.google.android.apps.maps": 0.3
            },
            "continue": 0.32,
            "seconds": {
              "default": {
                "median": 90.3,
                "sigma": 1.2
              },
              "com.kakao.talk": {
                "median": 76.7,
                "sigma": 1.2
              },
              "com.instagram.android": {
                "median": 215.2,
                "sigma": 1.1
              },
              "com.google.android.youtube": {
                "median": 714.8,
                "sigma": 1.0
              },
              "com.android.chrome": {
                "median": 267.9,
                "sigma": 1.1
              },
              "com.google.android.apps.maps": {
