        "kind": "rate",
        "window": {
          "from": "07:30",
          "to": "23:50"
        },
        "perHour": 1.583
      },
      "conditions": [
        {
          "kind": "phone_state",
          "field": "asleep",
          "op": "==",
          "value": false
        }
